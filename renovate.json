{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>nklmilojevic/renovate-config", "helpers:pinGitHubActionDigests"],
  "nix": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 4am on monday"]
  },
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "github actions",
      "separateMinorPatch": false
    },
    {
      "matchPackageNames": ["kube", "/^kube-/", "k8s-openapi", "deskribe"],
      "groupName": "kubernetes crates",
      "separateMajorMinor": false
    },
    {
      "matchManagers": ["nix"],
      "groupName": "nix dependencies",
      "separateMinorPatch": false
    },
    {
      "description": "The workflows hold the package signing keys and the tap token, and run the setup-nix composite action: Action updates are reviewed, never merged automatically.",
      "matchFileNames": [".github/workflows/**", ".github/actions/**"],
      "automerge": false
    }
  ]
}
